diff --git a/src/dynarmic/interface/A32/config.h b/src/dynarmic/interface/A32/config.h
index 360df06e..058561c2 100644
--- a/src/dynarmic/interface/A32/config.h
+++ b/src/dynarmic/interface/A32/config.h
@@ -61,6 +61,16 @@ enum class Exception {
 struct UserCallbacks : public TranslateCallbacks {
     virtual ~UserCallbacks() = default;
 
+    // Optional diagnostic observer. Only x64 actual compilation misses are observed.
+    // Callbacks must not execute guest code, re-enter the JIT, or throw.
+    virtual bool IsJitCompileProfilingEnabled() const noexcept { return false; }
+    virtual void JitCompileBegin(std::uint64_t) noexcept {}
+    virtual void JitCompileComplete(std::uint32_t, std::size_t) noexcept {}
+    virtual void JitCompileAborted() noexcept {}
+    virtual void JitCacheInvalidated() noexcept {}
+    virtual bool AllowJitPreparedBlock(std::uint64_t, std::uint32_t) noexcept { return false; }
+
+
     // All reads through this callback are 4-byte aligned.
     // Memory must be interpreted as little endian.
     std::optional<std::uint32_t> MemoryReadCode(VAddr vaddr) override { return MemoryRead32(vaddr); }
