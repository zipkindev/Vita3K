@@ -201,13 +201,45 @@ private:
         return GetBasicBlock(A32::LocationDescriptor{GetCurrentLocation()}.SetSingleStepping(true)).entrypoint;
     }
 
+    struct PreparationRejected {};
+    bool preparing_block = false;
+
+public:
+    std::size_t PrepareBlock(u64 value) {
+        ASSERT(!jit_interface->is_executing);
+        if (preparing_block || emitter.GetBasicBlock(IR::LocationDescriptor{value})
+            || Has(static_cast<HaltReason>(Atomic::Load(&jit_state.halt_reason)), HaltReason::CacheInvalidation))
+            return 0;
+        const A32::LocationDescriptor location{IR::LocationDescriptor{value}};
+        if (location.UniqueHash() != value || location.SingleStepping())
+            return 0;
+        const auto before = block_of_code.SpaceRemaining();
+        preparing_block = true;
+        SCOPE_EXIT { preparing_block = false; };
+        try { GetBasicBlock(IR::LocationDescriptor{value}); }
+        catch (const PreparationRejected&) { return 0; }
+        return before - block_of_code.SpaceRemaining();
+    }
+
+private:
     A32EmitX64::BlockDescriptor GetBasicBlock(IR::LocationDescriptor descriptor) {
         auto block = emitter.GetBasicBlock(descriptor);
         if (block)
             return *block;
 
+        const bool profiling = !preparing_block && conf.callbacks->IsJitCompileProfilingEnabled();
+        bool observed_complete = false;
+        if (profiling)
+            conf.callbacks->JitCompileBegin(descriptor.Value());
+        SCOPE_EXIT {
+            if (profiling && !observed_complete)
+                conf.callbacks->JitCompileAborted();
+        };
+
         constexpr size_t MINIMUM_REMAINING_CODESIZE = 1 * 1024 * 1024;
         if (block_of_code.SpaceRemaining() < MINIMUM_REMAINING_CODESIZE) {
+            if (preparing_block)
+                throw PreparationRejected{};
             invalidate_entire_cache = true;
             PerformRequestedCacheInvalidation(HaltReason::CacheInvalidation);
         }
@@ -227,7 +259,15 @@ private:
         }
         Optimization::IdentityRemovalPass(ir_block);
         Optimization::VerificationPass(ir_block);
-        return emitter.Emit(ir_block);
+        if (preparing_block && !conf.callbacks->AllowJitPreparedBlock(descriptor.Value(), A32::LocationDescriptor{ir_block.EndLocation()}.PC()))
+            throw PreparationRejected{};
+        const auto result = emitter.Emit(ir_block);
+        if (profiling) {
+            conf.callbacks->JitCompileComplete(A32::LocationDescriptor{ir_block.EndLocation()}.PC(),
+                result.size);
+            observed_complete = true;
+        }
+        return result;
     }
 
     void PerformRequestedCacheInvalidation(HaltReason hr) {
@@ -240,6 +280,8 @@ private:
                 return;
             }
 
+            if (conf.callbacks->IsJitCompileProfilingEnabled())
+                conf.callbacks->JitCacheInvalidated();
             jit_state.ResetRSB();
             if (invalidate_entire_cache) {
                 block_of_code.ClearCache();
@@ -280,6 +322,10 @@ HaltReason Jit::Step() {
     return impl->Step();
 }
 
+std::size_t Jit::PrepareBlock(std::uint64_t descriptor) {
+    return impl->PrepareBlock(descriptor);
+}
+
 void Jit::ClearCache() {
     impl->ClearCache();
 }
